<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <PackageId>Glutinum.Web</PackageId>
        <Description>Fable bindings for the DOM and web APIs, generated by Glutinum from @types/web</Description>
        <PackageProjectUrl>https://github.com/glutinum-org/cli</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <FablePackageType>binding</FablePackageType>
        <PackageTags>fable-javascript;fable-dom</PackageTags>
        <ChangelogFile>CHANGELOG.md</ChangelogFile>
        <NoWarn>$(NoWarn);FS0044</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <Compile Include="Glutinum.Web.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Glutinum.Types/Glutinum.Types.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="EasyBuild.PackageReleaseNotes.Tasks">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Fable.Core" />
        <PackageReference Include="Fable.Package.SDK">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
</Project>
